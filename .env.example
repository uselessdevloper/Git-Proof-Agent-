# ──────────────────────────────────────────────────────────────────────────────
# GitHub OAuth App (required)
# Create one at: https://github.com/settings/developers → "New OAuth App"
#
#   Homepage URL:               http://localhost:8000
#   Authorization callback URL: http://localhost:8000/auth/callback
#
# Copy this file to ".env" and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Any long random string — used to sign the session cookie.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_random_string

FRONTEND_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────────────────────
# Gemini API key (primary — enables LLM reasoning + lesson extraction)
# Get a free key at: https://aistudio.google.com/app/apikey
#
# Use either name — the backend checks both:
GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here   ← also works if you already have this

# ──────────────────────────────────────────────────────────────────────────────
# NVIDIA NIM / Nemotron (optional fallback — used if Gemini fails or is unset)
# Key format: nvapi-...
# ──────────────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Path for the SQLite memory database (optional, defaults to ./gitproof_memory.db)
# MEMORY_DB_PATH=gitproof_memory.db

